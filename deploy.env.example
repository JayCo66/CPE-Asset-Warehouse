# ค่าของ container เว็บ ใช้กับ docker run --env-file ; คัดลอกเป็น .env แล้วแก้ค่าที่มี CHANGE_ME
# เปิดเว็บที่ http://<host>:<port>/asset-warehouse/ (ว่างไว้ = เปิดที่ /)
BASE_PATH=/asset-warehouse

# ฐานข้อมูลต้นทาง (ระบบครุภัณฑ์) : หน้ายืม-คืนต้องเชื่อมต่อได้
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_NAME=cpeasset
DB_USER=cpe_web
DB_PASS=CHANGE_ME

# Data Warehouse : แดชบอร์ดทุกหน้าอ่านจากที่นี่ และการนำเข้า snapshot เขียนลงที่นี่
WAREHOUSE_DB_HOST=CHANGE_ME
WAREHOUSE_DB_PORT=3306
WAREHOUSE_DB_NAME=cpe_warehouse
WAREHOUSE_DB_USER=cpe_web
WAREHOUSE_DB_PASS=CHANGE_ME

# true เมื่ออยู่หลัง reverse proxy ที่ส่ง X-Forwarded-Host / X-Forwarded-Proto (ปุ่มนำเข้า snapshot ต้องใช้)
CPE_TRUST_PROXY_HEADERS=true

# Redis เป็นทางเลือก ไม่มีก็ทำงานได้ (ช้ากว่าเล็กน้อย)
REDIS_ENABLED=false
REDIS_HOST=
REDIS_PORT=6379
REDIS_KEY_PREFIX=cpe:production:
REDIS_TTL_ASSET_SUMMARY=86400
REDIS_TTL_SNAPSHOT_HISTORY=86400
