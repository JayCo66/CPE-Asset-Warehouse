APP_ENV=local
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_LOCAL_PORT=6380
REDIS_DB=0
REDIS_KEY_PREFIX=cpe:local:
REDIS_DEFAULT_TTL=300
REDIS_TTL_OVERVIEW=300
REDIS_TTL_BORROWING=120
REDIS_TTL_MAINTENANCE=120
REDIS_TTL_ASSET_SUMMARY=900
REDIS_TTL_SNAPSHOT_LIST=300
REDIS_TTL_SNAPSHOT_HISTORY=3600
REDIS_CONNECT_TIMEOUT=0.2
REDIS_READ_TIMEOUT=0.2
REDIS_MAX_ENTRY_BYTES=524288
CPE_SNAPSHOT_DAILY_TIME=02:00
CPE_SNAPSHOT_LOCK_TTL=600
CPE_SNAPSHOT_LOCK_WAIT_SECONDS=600
CPE_SNAPSHOT_MAX_ATTEMPTS=3
CPE_SNAPSHOT_RETRY_BASE_SECONDS=2
# Local archive directory; production should use its persistent archive mount.
CPE_SNAPSHOT_ARCHIVE_DIR=output/history
# CPE_SNAPSHOT_DAILY_TIME controls the Windows Task Scheduler registration script.
